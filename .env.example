# Copy to .env and fill in real credentials locally. Never commit .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
PINECONE_API_KEY=

PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

ADMIN_API_KEY=replace-with-a-long-random-secret
APP_ENV=development
MAX_UPLOAD_BYTES=26214400

# Optional paths; defaults are under the repository data/ and uploads/ folders.
# AUDIT_DB_PATH=
# DOCUMENT_REGISTRY_DB_PATH=
# UPLOAD_DIR=

# Trained statement-pair ANN artifact directory
ANN_ARTIFACT_DIR=artifacts/ann/ann-v1-seed42
# Optional override; otherwise uses the threshold selected during ANN validation
# ANN_CONFIDENCE_THRESHOLD=0.80
